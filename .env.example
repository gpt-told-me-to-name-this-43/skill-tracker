# The SQLAlchemy-style driver suffix (postgresql+asyncpg://) is still accepted, so an
# existing .env keeps working unchanged.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
# HS256 requires at least 32 bytes of key material.
JWT_SECRET=change-me-in-production-with-a-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
UPLOAD_DIR=uploads
GITHUB_REPO=gpt-told-me-to-name-this-43/skill-tracker
# GITHUB_TOKEN=ghp_optional-for-private-repos-and-higher-rate-limits
# OPENROUTER_API_KEY=sk-your-openrouter-key
# OPENROUTER_MODEL=poolside/laguna-xs-2.1:free
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Uncomment if outbound traffic has to go through a proxy on the host (for example
# Privoxy); the api container picks these up through env_file:
# added because of connectivity problems reaching OpenRouter from Russia
# HTTPS_PROXY=http://host.docker.internal:8118
# HTTP_PROXY=http://host.docker.internal:8118
# NO_PROXY=postgres,redis,localhost,127.0.0.1
