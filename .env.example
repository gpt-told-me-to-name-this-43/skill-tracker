DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
DEBUG=true
GITHUB_REPO=gpt-told-me-to-name-this-43/skill-tracker
# GITHUB_TOKEN=ghp_optional-for-private-repos-and-higher-rate-limits
# OPENROUTER_API_KEY=sk-your-openrouter-key
# OPENROUTER_MODEL=poolside/laguna-xs-2.1:free
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Если исходящий трафик должен идти через прокси на хосте (например Privoxy),
# раскомментируйте — контейнер api подхватит эти переменные через env_file:
# добавил в связи с проблема с openrouter из России
# HTTPS_PROXY=http://host.docker.internal:8118
# HTTP_PROXY=http://host.docker.internal:8118
# NO_PROXY=postgres,redis,localhost,127.0.0.1
